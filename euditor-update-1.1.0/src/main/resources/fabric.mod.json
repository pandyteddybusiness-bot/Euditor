  "license": "MIT",
  "icon": "assets/euditor/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.euditor.EuditorClient"]
  },
  "mixins": ["euditor.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.1",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
